# ─── Server Configuration ──────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# ─── Supabase Configuration ────────────────────────────────────────
# Your Supabase Project URL (found in Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key (for client/browser and public RLS queries)
SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (for admin backend operations that bypass RLS)
# ⚠️ Keep this secret and NEVER expose it to the frontend!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage Bucket Name (default: 'uploads')
SUPABASE_BUCKET_NAME=uploads

# ─── Security & Rate Limiting ──────────────────────────────────────
# CORS Allowed Origins (comma-separated or * for all)
CORS_ORIGIN=*

# General API rate limit window in milliseconds (default: 900000ms = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Public Submission burst rate limiting (default: 10 requests per minute)
SUBMISSION_RATE_LIMIT_WINDOW_MS=60000
SUBMISSION_RATE_LIMIT_MAX=10

# ─── CSRF & Cookie Security ────────────────────────────────────────
# Enable or disable CSRF protection (true/false)
CSRF_ENABLED=true

# Secret for signing cookies (at least 16 chars)
COOKIE_SECRET=change-this-cookie-secret-key-min-16

# Secret for signing CSRF tokens (at least 16 chars)
CSRF_SECRET=change-this-csrf-token-secret-key-min-16

# ─── Geolocation Providers (Fallback Chain) ─────────────────────────
# Provider A: IPStack API Key (Optional; if empty, ip-api.com free JSON is used)
IPSTACK_API_KEY=

# Provider B: ipapi.co (Free tier ~1000 requests/day, key is optional)
IPAPI_CO_KEY=

# ─── Acceptance Probe Deterministic Testing Toggles ─────────────────
# Set to 'true' to simulate Geo Provider A being down (Proves Probe 4 fallback)
MOCK_GEO_PROVIDER_A_FAIL=false

# Set to 'true' to simulate both Geo Providers being down (Proves Probe 4 graceful degradation)
MOCK_GEO_PROVIDER_B_FAIL=false

# Set to 'true' to simulate email/webhook failure (Proves Probe 5 safe side effects)
MOCK_NOTIFICATION_FAIL=false

# Webhook notification URL for lead alerts (Optional)
NOTIFICATION_WEBHOOK_URL=