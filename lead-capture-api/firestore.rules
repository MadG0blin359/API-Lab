rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Widgets Collection Rules
    match /widgets/{widgetId} {
      // Anyone can read active widget configuration for embedding
      allow read: if resource.data.is_active == true || isOwner(resource.data.user_id);
      
      // Only authenticated owners can create widgets for their user_id
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      
      // Only owner can update or delete
      allow update, delete: if isOwner(resource.data.user_id);
    }

    // Submissions Collection Rules
    match /submissions/{submissionId} {
      // Public internet visitors can submit leads (typically processed by the backend)
      allow create: if true;
      
      // Only the widget owner can read or delete their leads
      allow read, delete: if isOwner(resource.data.user_id);
      
      // Leads are immutable once submitted
      allow update: if false;
    }
  }
}
