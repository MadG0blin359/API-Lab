{
  "name": "typescript-express-supabase-boilerplate",
  "version": "1.0.0",
  "description": "Production-ready boilerplate for Express with TypeScript and Supabase",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/utils/seed.ts"
  },
  "keywords": [
    "typescript",
    "express",
    "supabase",
    "boilerplate",
    "rest-api",
    "backend"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "apilayer-ipstack": "^1.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/swagger-ui-express": "^4.1.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
