# API 
NODE_ENV=development
PORT=3000

# Postgres (Development)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=task_manager_db
DB_HOST=pgbouncer
DB_PORT=5432
DB_POOL_MAX=

# Postgres (Production / Supabase)
# Note: For Supabase Transaction Pooler, use aws-0-[region].pooler.supabase.com on port 6543
# and POSTGRES_USER must be formatted as: postgres.[project-ref]
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543
POSTGRES_DB=postgres
POSTGRES_USER=postgres.yourprojectref
POSTGRES_PASSWORD=
# Alternatively, use full connection string:
# DATABASE_URL=postgresql://postgres.yourprojectref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Pgbouncer
PGB_MAX_CLIENT_CONN=
PGB_DEFAULT_POOL_SIZE=  

# Redis (Development)
REDIS_HOST=task_api_redis
REDIS_PORT=6379

# Redis (Production)
REDIS_URL=redis://task_api_redis:6379

# Supabase
SUPABASE_URL=
SUPABASE_PUB_KEY=
SUPABASE_PASSWORD=

# CSRF Token (64-bytes)
CSRF_SECRET=