{
  "openapi": "3.0.0",
  "info": {
    "title": "Task API",
    "version": "1.0.0",
    "description": "API documentation for the task manager application with Supabase Authentication."
  },
  "servers": [
    {
      "url": "https://api-lab-kiw8.onrender.com",
      "description": "Production Server"
    },

    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "csrfAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-csrf-token",
        "description": "CSRF token required for state-changing operations. Automatically injected from cookies by the Swagger request interceptor."
      }
    }
  },
  "paths": {
    "/auth/csrf": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get a CSRF token",
        "description": "Sets a csrf_token cookie for use in subsequent state-changing requests.",
        "responses": {
          "201": {
            "description": "CSRF token attached to cookies"
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Create a new user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "user@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "securepassword123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully"
          },
          "400": {
            "description": "Bad Request (e.g., missing email/password or password too short)"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Authenticate & return a JWT",
        "description": "On success, sets access_token, refresh_token, and csrf_token cookies.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "user@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "securepassword123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated successfully, sets session cookies"
          },
          "400": {
            "description": "Bad Request (missing fields)"
          },
          "401": {
            "description": "Invalid login credentials"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "End the user's session",
        "security": [
          {
            "bearerAuth": [],
            "csrfAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "No Content (Logged out successfully)"
          },
          "401": {
            "description": "Access token required or invalid"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Refresh an expired access token",
        "description": "Exchanges a valid, long-lived refresh token for a new access token and refresh token pair to maintain an active user session.",
        "security": [
          {
            "csrfAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session refreshed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string",
                      "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                    },
                    "refresh_token": {
                      "type": "string",
                      "example": "vw6dfkdcfqfq"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request (Refresh token is missing from the payload)"
          },
          "401": {
            "description": "Unauthorized (Invalid or expired refresh token)"
          }
        }
      }
    },
    "/user/public": {
      "get": {
        "tags": ["User Context"],
        "summary": "Read public, open data",
        "responses": {
          "200": {
            "description": "Welcome message returned"
          }
        }
      }
    },
    "/user/profile": {
      "get": {
        "tags": ["User Context"],
        "summary": "Read private profile data",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User metadata retrieved successfully"
          },
          "401": {
            "description": "Invalid or expired token"
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get all tasks for the authenticated user",
        "description": "Retrieve a list of the current user's tasks. Supports filtering, searching, and pagination.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "isComplete",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Filter tasks by completion status"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search tasks by title or description"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Maximum number of tasks to return (for pagination)"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Number of tasks to skip before returning results (for pagination)"
          }
        ],
        "responses": {
          "200": {
            "description": "List of tasks retrieved successfully"
          },
          "401": {
            "description": "Access token required or invalid"
          },
          "404": {
            "description": "No tasks found"
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create a new task",
        "security": [
          {
            "bearerAuth": [],
            "csrfAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Complete API integration"
                  },
                  "description": {
                    "type": "string",
                    "example": "Finalize the SQLite endpoints before migrating to Postgres."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created successfully"
          },
          "400": {
            "description": "Please provide a valid title"
          },
          "401": {
            "description": "Access token required or invalid"
          }
        }
      }
    },
    "/tasks/stats": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task statistics for the authenticated user",
        "description": "Retrieve aggregated statistics including total, completed, and pending tasks for the current user.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Task statistics retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer",
                          "example": 3
                        },
                        "complete": {
                          "type": "integer",
                          "example": 2
                        },
                        "pending": {
                          "type": "integer",
                          "example": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Access token required or invalid"
          },
          "500": {
            "description": "Failed to compute database statistics"
          }
        }
      }
    },
    "/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get a single task by ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The task ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Task retrieved successfully"
          },
          "400": {
            "description": "Invalid ID format provided"
          },
          "401": {
            "description": "Access token required or invalid"
          },
          "404": {
            "description": "No task was found with ID"
          }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update an existing task",
        "security": [
          {
            "bearerAuth": [],
            "csrfAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The task ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Updated Task Title"
                  },
                  "description": {
                    "type": "string",
                    "example": "Updated details for the task."
                  },
                  "isComplete": {
                    "type": "boolean",
                    "example": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task updated successfully"
          },
          "400": {
            "description": "Invalid ID format or missing fields"
          },
          "401": {
            "description": "Access token required or invalid"
          },
          "404": {
            "description": "No task was found with ID"
          }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete a task by ID",
        "security": [
          {
            "bearerAuth": [],
            "csrfAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The task ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Task deleted successfully"
          },
          "400": {
            "description": "Invalid ID format provided"
          },
          "401": {
            "description": "Access token required or invalid"
          },
          "404": {
            "description": "No task was found with ID"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Meta"],
        "summary": "Server health check",
        "responses": {
          "200": {
            "description": "Server is up and running"
          },
          "500": {
            "description": "Database health check failed"
          }
        }
      }
    }
  }
}
