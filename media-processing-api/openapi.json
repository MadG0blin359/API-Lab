{
  "openapi": "3.0.3",
  "info": {
    "title": "Media Processing API",
    "version": "1.2.0",
    "description": "Production asset optimization backend. Features magic byte MIME verification, rate limiting, Inngest concurrency controls, responsive variants (thumbnail, medium, full), LQIP & BlurHash, dynamic 1-hour signed URLs, real-time SSE streaming, health/readiness probes, and Prometheus metrics."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness probe",
        "description": "Checks if the API process is alive and responsive.",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "healthy" },
                    "timestamp": { "type": "string" },
                    "uptime": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness probe",
        "description": "Deep health check verifying connectivity to Supabase PostgreSQL and Storage buckets.",
        "responses": {
          "200": {
            "description": "All backend dependencies healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ready" },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "database": { "type": "string", "example": "healthy" },
                        "storage": { "type": "string", "example": "healthy" }
                      }
                    },
                    "timestamp": { "type": "string" }
                  }
                }
              }
            }
          },
          "503": {
            "description": "One or more dependencies unhealthy"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus Metrics",
        "description": "Exports system and application metrics in standard Prometheus text exposition format.",
        "responses": {
          "200": {
            "description": "Prometheus metrics output",
            "content": {
              "text/plain": {}
            }
          }
        }
      }
    },
    "/api/media/upload": {
      "post": {
        "summary": "Upload media for processing",
        "description": "Ingests a single image file (JPG, PNG, WebP up to 10MB). Enforces binary magic byte verification and rate limits (10 uploads/min per IP). Returns immediately with a tracking job ID.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["mediaFile"],
                "properties": {
                  "mediaFile": {
                    "type": "string",
                    "format": "binary",
                    "description": "Image file (JPEG, PNG, or WebP, max 10MB)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Media processing accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "message": { "type": "string", "example": "Media processing accepted." },
                    "jobId": { "type": "string", "format": "uuid" }
                  }
                }
              }
            }
          },
          "400": { "description": "No file provided" },
          "415": { "description": "Invalid format or fake magic byte signature" },
          "429": { "description": "Rate limit exceeded (10 uploads/min)" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/media/{id}": {
      "get": {
        "summary": "Get job processing status",
        "description": "Retrieves the status of a job. When completed, dynamically signs 1-hour secure URLs for all responsive variants (thumbnail, medium, full) and returns LQIP and BlurHash.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": { "type": "string", "enum": ["pending", "processing", "completed", "failed"] },
                        "result_url": {
                          "type": "object",
                          "properties": {
                            "variants": {
                              "type": "object",
                              "properties": {
                                "thumbnail": { "type": "object", "properties": { "url": { "type": "string" }, "width": { "type": "number" }, "height": { "type": "number" } } },
                                "medium": { "type": "object", "properties": { "url": { "type": "string" }, "width": { "type": "number" }, "height": { "type": "number" } } },
                                "full": { "type": "object", "properties": { "url": { "type": "string" }, "width": { "type": "number" }, "height": { "type": "number" } } }
                              }
                            },
                            "blurhash": { "type": "string", "example": "U9TMlm}EfQ}E}EoKfQoKfQfQfQfQ}EoKfQoK" },
                            "lqip": { "type": "string", "example": "data:image/webp;base64,..." }
                          }
                        },
                        "error_message": { "type": "string", "nullable": true }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Job ID not found" }
        }
      }
    },
    "/api/media/{id}/events": {
      "get": {
        "summary": "Stream job status via Server-Sent Events (SSE)",
        "description": "Maintains an open SSE stream connection to deliver real-time progress updates directly to the client without polling.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Real-time SSE event stream",
            "content": {
              "text/event-stream": {}
            }
          },
          "404": { "description": "Job ID not found" }
        }
      }
    }
  }
}
