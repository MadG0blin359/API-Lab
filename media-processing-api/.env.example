# ─── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Supabase ────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ─── Inngest ─────────────────────────────────────────────────────
INNGEST_EVENT_KEY=your-event-key
INNGEST_SIGNING_KEY=your-signing-key

# ─── Free-Tier Optimizations (Render 512MB RAM & Inngest Steps) ──
# Concurrency limit = 1 prevents Render container OOM crashes during Sharp processing
INNGEST_CONCURRENCY_LIMIT=1
# Rate limit = 30 background executions per minute
INNGEST_RATE_LIMIT=30
# Run cleanup twice daily (every 12h) instead of hourly to conserve free Inngest monthly steps
CLEANUP_CRON_EXPRESSION=0 */12 * * *

# ─── Optional Overrides ─────────────────────────────────────────
# SUPABASE_BUCKET_NAME=media-assets
# MAX_FILE_SIZE_MB=10
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com